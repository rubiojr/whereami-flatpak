#!/usr/bin/env bash

set -euo pipefail

readonly APP_ID="io.github.rubiojr.whereami"
readonly MANIFEST="${APP_ID}.yml"
readonly FLATPAK_REMOTE="flathub"
readonly FLATPAK_REMOTE_URL="https://flathub.org/repo/flathub.flatpakrepo"

local_manifest=""

usage() {
    cat <<EOF
Usage: scripts/build SOURCE_DIR

Build whereami from SOURCE_DIR and install it in the user Flatpak installation.
The release manifest is not modified.
EOF
}

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

cleanup() {
    if [[ -n "$local_manifest" ]]; then
        rm -f "$local_manifest"
    fi
}
trap cleanup EXIT

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

[[ $# -eq 1 ]] || {
    usage >&2
    exit 2
}

[[ -d "$1" ]] || die "source directory does not exist: $1"
source_dir=$(cd "$1" && pwd -P)
[[ -f "${source_dir}/go.mod" ]] || die "source directory does not contain go.mod: ${source_dir}"

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

require_command flatpak
require_command flatpak-builder
require_command jq

local_manifest=$(mktemp "${repo_root}/.local-manifest.XXXXXX.json")
flatpak-builder --show-manifest "$MANIFEST" | jq --arg source "$source_dir" '
    if ([.modules[] | select(.name == "whereami")] | length) != 1 then
        error("expected exactly one whereami module")
    else
        (.modules[] | select(.name == "whereami") | .sources[0]) = {
            "type": "dir",
            "path": $source
        }
    end
' >"$local_manifest"

printf '==> Building whereami from %s\n' "$source_dir"
flatpak remote-add --user --if-not-exists "$FLATPAK_REMOTE" "$FLATPAK_REMOTE_URL"
flatpak-builder --user --install --install-deps-from="$FLATPAK_REMOTE" --assumeyes \
    --ccache --force-clean "${repo_root}/build-local" "$local_manifest"

printf '==> Installed %s for the current user\n' "$APP_ID"
printf '    flatpak run --user %s\n' "$APP_ID"

#!/usr/bin/env bash

set -euo pipefail

readonly APP_ID="io.github.rubiojr.whereami"
readonly BUNDLE="${APP_ID}.flatpak"
readonly MANIFEST="${APP_ID}.yml"
readonly UPSTREAM_REPO="rubiojr/whereami"
readonly UPSTREAM_URL="https://github.com/${UPSTREAM_REPO}.git"
readonly FLATPAK_GO_MOD_VERSION="v0.1.0"

work_dir=""

usage() {
    cat <<EOF
Usage:
  scripts/release update TAG
  scripts/release publish [--force] [TAG]

Commands:
  update   Regenerate dependency metadata and pin the manifest to TAG.
           This command does not build, commit, push, or publish.
  publish  Verify the packaging commit is pushed, build a fresh bundle,
           upload it to the matching whereami release, and publish it.
           TAG defaults to the version pinned in the manifest.
           Refuses to modify a published release unless --force is used.
EOF
}

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

log() {
    printf '==> %s\n' "$*"
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

validate_tag() {
    [[ "$1" =~ ^v[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]] || \
        die "tag must be a semantic version beginning with v, for example v0.1.11"
}

require_clean_worktree() {
    if [[ -n $(git status --porcelain --untracked-files=all) ]]; then
        die "the worktree has uncommitted files; review and commit them first"
    fi
}

require_clean_release_files() {
    if ! git diff --quiet -- "$MANIFEST" go.mod.json modules.txt || \
        ! git diff --cached --quiet -- "$MANIFEST" go.mod.json modules.txt; then
        die "release metadata has uncommitted changes; review or discard it first"
    fi
}

manifest_tag() {
    local value
    value=$(sed -n 's/^        tag:[[:space:]]*//p' "$MANIFEST")
    [[ $(printf '%s\n' "$value" | sed '/^$/d' | wc -l) -eq 1 ]] || \
        die "could not identify one source tag in ${MANIFEST}"
    printf '%s\n' "$value"
}

cleanup() {
    if [[ -n "$work_dir" && -d "$work_dir" ]]; then
        rm -rf "$work_dir"
    fi
}
trap cleanup EXIT

[[ $# -gt 0 ]] || {
    usage >&2
    exit 2
}

command_name="$1"
shift

if [[ "$command_name" == "-h" || "$command_name" == "--help" ]]; then
    usage
    exit 0
fi

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

require_command git
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not inside a Git repository"

case "$command_name" in
    update)
        [[ $# -eq 1 ]] || die "update requires exactly one tag"
        tag="$1"
        validate_tag "$tag"
        require_command go
        require_clean_release_files

        work_dir=$(mktemp -d)
        source_dir="${work_dir}/whereami"
        generated_dir="${work_dir}/generated"
        mkdir "$generated_dir"

        log "Fetching ${UPSTREAM_REPO} ${tag}"
        if ! git -c advice.detachedHead=false clone \
            --quiet --depth 1 --branch "$tag" "$UPSTREAM_URL" "$source_dir"; then
            die "could not check out ${UPSTREAM_REPO} tag ${tag}; make sure the tag was pushed"
        fi
        commit=$(git -C "$source_dir" rev-parse HEAD)

        log "Generating offline Go module sources"
        (
            cd "$source_dir"
            GOFLAGS=-mod=mod go run "github.com/dennwc/flatpak-go-mod@${FLATPAK_GO_MOD_VERSION}" \
                -json -out "$generated_dir" .
        )
        cp "${generated_dir}/go.mod.json" "${repo_root}/go.mod.json"
        cp "${generated_dir}/modules.txt" "${repo_root}/modules.txt"

        [[ $(grep -c '^        tag:' "$MANIFEST") -eq 1 ]] || \
            die "could not identify one source tag in ${MANIFEST}"
        [[ $(grep -c '^        commit:' "$MANIFEST") -eq 1 ]] || \
            die "could not identify one source commit in ${MANIFEST}"
        updated_manifest="${work_dir}/${MANIFEST}"
        sed \
            -e "s|^        tag:.*|        tag: ${tag}|" \
            -e "s|^        commit:.*|        commit: ${commit}|" \
            "$MANIFEST" >"$updated_manifest"
        cp "$updated_manifest" "$MANIFEST"
        rm -f "$BUNDLE"

        log "Updated ${tag} (${commit})"
        printf '\nReview and test:\n'
        printf '  git diff\n'
        printf '  make flatpak-rebuild\n'
        printf '\nThen commit and push before publishing:\n'
        printf '  git add %s go.mod.json modules.txt\n' "$MANIFEST"
        printf '  git commit -m %q\n' "Update whereami to ${tag}"
        printf '  git push\n'
        printf '  ./scripts/release publish\n'
        ;;

    publish)
        force=false
        if [[ "${1:-}" == "--force" ]]; then
            force=true
            shift
        fi
        [[ $# -le 1 ]] || die "publish accepts an optional --force and tag"
        pinned_tag=$(manifest_tag)
        tag="${1:-$pinned_tag}"
        validate_tag "$tag"
        [[ "$tag" == "$pinned_tag" ]] || \
            die "requested tag ${tag} does not match manifest tag ${pinned_tag}"

        require_command make
        require_command flatpak
        require_command flatpak-builder
        require_command gh
        require_clean_worktree
        git ls-files --error-unmatch "$MANIFEST" go.mod.json modules.txt >/dev/null 2>&1 || \
            die "manifest and dependency metadata must be tracked by Git"
        gh auth status --hostname github.com >/dev/null 2>&1 || \
            die "GitHub CLI is not authenticated"

        branch=$(git symbolic-ref --quiet --short HEAD) || \
            die "the packaging repository is in detached HEAD state"
        git remote get-url origin >/dev/null 2>&1 || \
            die "the packaging repository has no origin remote"

        log "Verifying ${branch} is pushed"
        git fetch --quiet origin "$branch"
        [[ $(git rev-parse HEAD) == "$(git rev-parse FETCH_HEAD)" ]] || \
            die "the current packaging commit is not pushed to origin/${branch}"

        release_exists=false
        if gh release view "$tag" --repo "$UPSTREAM_REPO" >/dev/null 2>&1; then
            release_exists=true
            release_is_draft=$(gh release view "$tag" --repo "$UPSTREAM_REPO" --json isDraft --jq .isDraft)
            if [[ "$release_is_draft" == false && "$force" == false ]]; then
                die "release ${tag} is already published; use publish --force ${tag} to replace its Flatpak"
            fi
        fi

        log "Building ${BUNDLE}"
        make flatpak-rebuild
        [[ -f "$BUNDLE" ]] || die "build completed without creating ${BUNDLE}"

        if [[ "$release_exists" == true ]]; then
            log "Using existing GitHub release ${tag}"
        else
            log "Creating draft GitHub release ${tag}"
            gh release create "$tag" \
                --repo "$UPSTREAM_REPO" \
                --verify-tag \
                --draft \
                --generate-notes \
                --title "whereami ${tag}"
            release_is_draft=true
        fi

        log "Uploading ${BUNDLE} to ${UPSTREAM_REPO} ${tag}"
        gh release upload "$tag" "$BUNDLE" --repo "$UPSTREAM_REPO" --clobber

        if [[ "$release_is_draft" == true ]]; then
            log "Publishing GitHub release ${tag}"
            gh release edit "$tag" --repo "$UPSTREAM_REPO" --draft=false
        fi

        release_url=$(gh release view "$tag" --repo "$UPSTREAM_REPO" --json url --jq .url)
        log "Published ${release_url}"
        ;;

    *)
        usage >&2
        die "unknown command: ${command_name}"
        ;;
esac

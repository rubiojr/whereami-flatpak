#!/usr/bin/env bash

set -euo pipefail

readonly APP_ID="io.github.rubiojr.whereami"
readonly BUNDLE="${APP_ID}.flatpak"
readonly MANIFEST="${APP_ID}.yml"
readonly FLATPAK_GO_MOD_VERSION="v0.1.0"
readonly FLATPAK_REMOTE="flathub"
readonly FLATPAK_REMOTE_URL="https://flathub.org/repo/flathub.flatpakrepo"
readonly FLATPAK_RUNTIME_REPO="https://dl.flathub.org/repo/flathub.flatpakrepo"
readonly CONTAINER_IMAGE="docker.io/library/fedora:44"
readonly DEV_CACHE_VOLUME="whereami-flatpak-f44-kde69-${HOSTTYPE:-unknown}"

usage() {
    cat <<EOF
Usage:
  ./build dev [SOURCE_DIR]
  ./build release TAG [SOURCE_DIR]

Both modes create ${BUNDLE}.

dev      Builds the current local source, including uncommitted changes.
release  Requires a clean source tree with TAG checked out at HEAD and builds
         that exact tag. It does not upload or publish anything.

SOURCE_DIR defaults to the parent directory.
EOF
}

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

work_dir=""
local_manifest=""
cleanup() {
    [[ -z "$local_manifest" ]] || rm -f "$local_manifest"
    [[ -z "$work_dir" ]] || rm -rf "$work_dir"
}
trap cleanup EXIT

mode="${1:-}"
case "$mode" in
    dev)
        [[ $# -le 2 ]] || { usage >&2; exit 2; }
        source_arg="${2:-..}"
        tag=""
        commit=""
        ;;
    release)
        [[ $# -ge 2 && $# -le 3 ]] || { usage >&2; exit 2; }
        tag="$2"
        source_arg="${3:-..}"
        ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

[[ -d "$source_arg" ]] || die "source directory does not exist: $source_arg"
source_dir=$(cd "$source_arg" && pwd -P)
[[ -f "${source_dir}/go.mod" ]] || die "source directory does not contain go.mod: $source_dir"

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cd "$repo_root"

if [[ -z "${WHEREAMI_FLATPAK_IN_CONTAINER:-}" ]]; then
    require_command podman
    [[ $(podman info --format '{{.Host.Security.Rootless}}') == "true" ]] || \
        die "the build requires rootless Podman"

    output_dir=$(mktemp -d "${TMPDIR:-/tmp}/whereami-flatpak.XXXXXX")
    trap 'rm -rf "$output_dir"' EXIT

    container_args=(
        run --rm --privileged --security-opt label=disable
        --workdir /work
        --mount "type=bind,src=${repo_root},dst=/packaging,ro=true"
        --mount "type=bind,src=${source_dir},dst=/source,ro=true"
        --mount "type=bind,src=${output_dir},dst=/output"
        --env WHEREAMI_FLATPAK_IN_CONTAINER=1
        --env WHEREAMI_FLATPAK_BUILD_ROOT=/work
        --env WHEREAMI_FLATPAK_OUTPUT_DIR=/output
        --env HOME=/work/home
        --env XDG_CACHE_HOME=/work/xdg/cache
        --env XDG_CONFIG_HOME=/work/xdg/config
        --env XDG_DATA_HOME=/work/xdg/data
        --env GOMODCACHE=/work/go/pkg/mod
        --env GOCACHE=/work/go/cache
        --env CCACHE_DIR=/work/ccache
    )
    if [[ "$mode" == "dev" ]]; then
        container_args+=(--mount "type=volume,src=${DEV_CACHE_VOLUME},dst=/work")
        printf '==> Using development cache volume %s\n' "$DEV_CACHE_VOLUME"
    fi

    printf '==> Building in %s container\n' "$CONTAINER_IMAGE"
    podman "${container_args[@]}" \
        "$CONTAINER_IMAGE" \
        bash -c 'dnf install -y flatpak flatpak-builder git golang jq tar && exec /packaging/build "$@"' \
        bash "$mode" ${tag:+"$tag"} /source

    [[ -f "${output_dir}/${BUNDLE}" ]] || die "container did not create $BUNDLE"
    rm -f "$BUNDLE"
    mv "${output_dir}/${BUNDLE}" "$BUNDLE"
    printf '==> Bundle created: %s/%s\n' "$repo_root" "$BUNDLE"
    exit 0
fi

require_command flatpak
require_command flatpak-builder
require_command git
require_command go
require_command jq
require_command tar

build_root="${WHEREAMI_FLATPAK_BUILD_ROOT:-$repo_root}"
output_dir="${WHEREAMI_FLATPAK_OUTPUT_DIR:-$repo_root}"
mkdir -p "$build_root" "$output_dir"
cd "$build_root"

work_dir=$(mktemp -d "${build_root}/.build-work.XXXXXX")
generation_source="${work_dir}/source"
generation_output="${work_dir}/dependencies"
mkdir "$generation_source" "$generation_output"

if [[ "$mode" == "release" ]]; then
    [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]] || \
        die "tag must be a semantic version beginning with v, for example v0.1.12"
    [[ -z $(git -C "$source_dir" status --porcelain --untracked-files=all) ]] || \
        die "release source tree must be clean"
    commit=$(git -C "$source_dir" rev-parse --verify "${tag}^{commit}" 2>/dev/null) || \
        die "tag not found in source repository: $tag"
    [[ "$commit" == "$(git -C "$source_dir" rev-parse HEAD)" ]] || \
        die "release tag $tag is not checked out at HEAD"
    git -C "$source_dir" archive "$commit" | tar -C "$generation_source" -xf -
else
    # Include uncommitted source while excluding generated and host-only state.
    tar -C "$source_dir" \
        --exclude='./.git' \
        --exclude='./.flatpak-builder' \
        --exclude='./.octmp' \
        --exclude='./bin' \
        --exclude='./build-dir' \
        --exclude='./dist' \
        --exclude='./export-dir' \
        --exclude='./resources_gen.go' \
        --exclude='./resources_gen.rcc' \
        --exclude='./vendor' \
        --exclude='./web' \
        --exclude='./whereami' \
        --exclude='./whereami-flatpak' \
        -cf - . | tar -C "$generation_source" -xf -
fi

printf '==> Generating Go dependency sources\n'
(
    cd "$generation_source"
    GOFLAGS=-mod=mod go run "github.com/dennwc/flatpak-go-mod@${FLATPAK_GO_MOD_VERSION}" \
        -json -out "$generation_output" .
)

modules_path="${generation_output}/modules.txt"
local_manifest=$(mktemp "${build_root}/.build-manifest.XXXXXX.json")

flatpak-builder --show-manifest "${repo_root}/${MANIFEST}" | jq \
    --arg mode "$mode" \
    --arg source "$source_dir" \
    --arg tag "$tag" \
    --arg commit "$commit" \
    --arg modules "$modules_path" \
    --slurpfile dependencies "${generation_output}/go.mod.json" '
    ($dependencies[0] | map(
        if .type == "file" and .path == "modules.txt" then
            .path = $modules
        else
            .
        end
    )) as $go_sources |
    (if $mode == "dev" then
        {
            "type": "dir",
            "path": $source,
            "skip": [
                ".git", ".flatpak-builder", ".octmp", "bin", "build-dir",
                "dist", "export-dir", "resources_gen.go", "resources_gen.rcc",
                "vendor", "web", "whereami", "whereami-flatpak"
            ]
        }
    else
        {"type": "git", "path": $source, "tag": $tag, "commit": $commit}
    end) as $app_source |
    (.modules[] | select(.name == "whereami") | .sources) = ([$app_source] + $go_sources)
' >"$local_manifest"

printf '==> Building %s bundle\n' "$mode"
flatpak remote-add --user --if-not-exists "$FLATPAK_REMOTE" "$FLATPAK_REMOTE_URL"
build_dir="${build_root}/build-dir"
export_dir="${build_root}/export-dir"
state_dir="${build_root}/.flatpak-builder"
mkdir -p "$export_dir"
rm -f "${output_dir}/${BUNDLE}"
builder_args=(
    --user
    "--install-deps-from=${FLATPAK_REMOTE}"
    --assumeyes
    --disable-rofiles-fuse
    "--state-dir=${state_dir}"
    "--repo=${export_dir}"
    --force-clean
)
if [[ "$mode" == "dev" ]]; then
    builder_args+=(--ccache)
fi
flatpak-builder "${builder_args[@]}" "$build_dir" "$local_manifest"
flatpak build-bundle --runtime-repo="$FLATPAK_RUNTIME_REPO" \
    "$export_dir" "${output_dir}/${BUNDLE}" "$APP_ID"
[[ -f "${output_dir}/${BUNDLE}" ]] || die "flatpak did not create $BUNDLE"

printf '==> Container bundle created: %s/%s\n' "$output_dir" "$BUNDLE"
